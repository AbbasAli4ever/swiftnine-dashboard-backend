// ============================================================
// FocusHub V1 - Prisma Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../libs/database/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Which OpenAI model tier a workspace member is entitled to.
/// Entitlement, not permission — deliberately separate from Role.
enum AiModelTier {
  PREMIUM
  STANDARD
}

enum WorkspaceUse {
  WORK
  PERSONAL
  SCHOOL
}

enum WorkspaceManagementType {
  HR_RECRUITING
  CREATIVE_DESIGN
  PROFESSIONAL_SERVICES
  FINANCE_ACCOUNTING
  OPERATIONS
  SOFTWARE_DEVELOPMENT
  IT
  SALES_CRM
  PERSONAL_USE
  SUPPORT
  STARTUP
  PMO
  MARKETING
  OTHER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
  NONE
}

enum StatusGroup {
  NOT_STARTED
  ACTIVE
  DONE
  CLOSED
}

enum AttachmentKind {
  FILE
  LINK
}

enum AttachmentContentType {
  IMAGE
  PDF
  PPT
  EXCEL
  CSV
  DOCUMENT
  CODE
  TEXT
  GENERATED_IMAGE
  GENERATED_PDF
  GENERATED_PPT
}

// PENDING rows exist briefly between presign and confirm for AI-conversation
// attachments; every other existing attachment flow creates its row only
// once the S3 object is confirmed, so this defaults to CONFIRMED and leaves
// those flows unaffected.
enum AttachmentUploadStatus {
  PENDING
  CONFIRMED
}

// ============================================================
// MODELS
// ============================================================

/// Core user account — profile, auth, online status
model User {
  id                      String    @id @default(uuid())
  fullName                String    @map("full_name")
  email                   String    @unique
  passwordHash            String?   @map("password_hash")
  googleId                String?   @unique @map("google_id")
  avatarUrl               String?   @map("avatar_url")
  avatarColor             String    @default("#6366f1") @map("avatar_color")
  designation             String?
  bio                     String?
  isOnline                Boolean   @default(false) @map("is_online")
  lastSeenAt              DateTime? @map("last_seen_at")
  timezone                String?
  notificationPreferences Json      @default("{}") @map("notification_preferences")
  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  // Relations
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  workspacesCreated          Workspace[]              @relation("WorkspaceCreator")
  workspaceMembers           WorkspaceMember[]
  projectFavorites           ProjectFavorite[]
  taskFavorites              TaskFavorite[]
  projectUnlockSessions      ProjectUnlockSession[]
  projectUnlockAttempts      ProjectUnlockAttempt[]
  channelMembers             ChannelMember[]
  channelMessagesSent        ChannelMessage[]         @relation("ChannelMessageSender")
  channelMessagesPinned      ChannelMessage[]         @relation("ChannelMessagePinner")
  channelMessageMentions     ChannelMessageMention[]
  channelMessageReactions    ChannelMessageReaction[]
  channelJoinRequestsMade    ChannelJoinRequest[]     @relation("JoinRequester")
  channelJoinRequestsDecided ChannelJoinRequest[]     @relation("JoinRequestDecider")
  workspaceInvitesSent       WorkspaceInvite[]        @relation("InviteSender")
  projectsCreated            Project[]                @relation("ProjectCreator")
  projectPasswordsSet        Project[]                @relation("ProjectPasswordSetter")
  taskListsCreated           TaskList[]               @relation("TaskListCreator")
  taskListsOwned             TaskList[]               @relation("TaskListOwner")
  tasksCreated               Task[]                   @relation("TaskCreator")
  taskAssignments            TaskAssignee[]           @relation("AssignedUser")
  taskAssignmentsMade        TaskAssignee[]           @relation("AssignedByUser")
  comments                   Comment[]
  mentions                   Mention[]
  notificationsReceived      Notification[]           @relation("NotificationRecipient")
  notificationsTriggered     Notification[]           @relation("NotificationActor")
  attachmentsUploaded        Attachment[]
  timeEntries                TimeEntry[]
  activityLogs               ActivityLog[]
  docsOwned                  Doc[]                    @relation("DocOwner")
  docVersionsCreated         DocVersion[]             @relation("DocVersionCreator")
  docPermissionsGranted      DocPermission[]          @relation("DocPermissionGranter")
  docPermissionsReceived     DocPermission[]          @relation("DocPermissionGrantee")
  docThreadsCreated          DocCommentThread[]       @relation("DocThreadCreator")
  docCommentsAuthored        DocComment[]             @relation("DocCommentAuthor")
  docShareLinksCreated       DocShareLink[]           @relation("DocShareLinkCreator")
  aiConversations            AiConversation[]
  tierChangeAttempt          TierChangeAttempt?
  aiTierChangesReceived      AiTierChangeLog[]        @relation("AiTierChangeTarget")
  aiTierChangesMade          AiTierChangeLog[]        @relation("AiTierChangeActor")
  aiTokenAllowances          AiTokenAllowance[]
  aiTokenAllowanceHistory    AiTokenAllowanceHistory[] @relation("AiTokenAllowanceSubject")
  aiTokenAllowanceActions    AiTokenAllowanceHistory[] @relation("AiTokenAllowanceActor")

  @@map("users")
}

/// Hashed refresh tokens for JWT auth — one user can have multiple sessions
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Short-lived token for password reset via email link — one active token per user
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Short-lived OTP for email verification on sign-up — one active token per user
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  otpHash   String   @unique @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Top-level organizational container — users can belong to multiple
model Workspace {
  id             String                  @id @default(uuid())
  name           String
  logoUrl        String?                 @map("logo_url")
  workspaceUse   WorkspaceUse            @map("workspace_use")
  managementType WorkspaceManagementType @map("management_type")
  createdBy      String                  @map("created_by")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  // Relations
  creator          User              @relation("WorkspaceCreator", fields: [createdBy], references: [id])
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  projects         Project[]
  channels         Channel[]
  tags             Tag[]
  activityLogs     ActivityLog[]
  docs             Doc[]
  projectFavorites ProjectFavorite[]
  taskFavorites    TaskFavorite[]
  notifications    Notification[]
  aiConversations  AiConversation[]
  aiTierChangeLogs AiTierChangeLog[]
  aiTokenAllowances       AiTokenAllowance[]
  aiTokenAllowanceHistory AiTokenAllowanceHistory[]

  @@map("workspaces")
}

/// Junction: User <-> Workspace with role assignment
model WorkspaceMember {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  userId      String      @map("user_id")
  role        Role        @default(MEMBER)
  aiModelTier AiModelTier @default(STANDARD) @map("ai_model_tier")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  // Relations
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// Pending email invitations — token expires after 7 days
model WorkspaceInvite {
  id          String       @id @default(uuid())
  workspaceId String       @map("workspace_id")
  email       String
  role        Role         @default(MEMBER)
  inviteToken String       @unique @map("invite_token")
  invitedBy   String       @map("invited_by")
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User      @relation("InviteSender", fields: [invitedBy], references: [id])

  @@index([workspaceId, email, status])
  @@map("workspace_invites")
}

/// Projects (Spaces) — lives inside a workspace, has own statuses and task counter
model Project {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  name              String
  description       String?
  color             String    @default("#6366f1")
  icon              String?
  taskIdPrefix      String    @map("task_id_prefix")
  taskCounter       Int       @default(0) @map("task_counter")
  isArchived        Boolean   @default(false) @map("is_archived")
  createdBy         String    @map("created_by")
  passwordHash      String?   @map("password_hash")
  passwordSetBy     String?   @map("password_set_by")
  passwordUpdatedAt DateTime? @map("password_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             User                        @relation("ProjectCreator", fields: [createdBy], references: [id])
  passwordSetter      User?                       @relation("ProjectPasswordSetter", fields: [passwordSetBy], references: [id])
  channels            Channel[]
  taskLists           TaskList[]
  statuses            Status[]
  docs                Doc[]
  favorites           ProjectFavorite[]
  unlockSessions      ProjectUnlockSession[]
  unlockAttempts      ProjectUnlockAttempt[]
  passwordResetTokens ProjectPasswordResetToken[]
  attachments         Attachment[]

  @@unique([workspaceId, taskIdPrefix])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectUnlockSession {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([expiresAt])
  @@map("project_unlock_sessions")
}

model ProjectUnlockAttempt {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  userId      String    @map("user_id")
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")
  lastFailAt  DateTime? @map("last_fail_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([lockedUntil])
  @@map("project_unlock_attempts")
}

model ProjectPasswordResetToken {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([expiresAt])
  @@map("project_password_reset_tokens")
}

/// Task lists inside a project — gap-based positioning
model TaskList {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  position    Int       @default(1000)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  ownerUserId String?   @map("owner_user_id")
  priority    Priority?
  isArchived  Boolean   @default(false) @map("is_archived")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User         @relation("TaskListCreator", fields: [createdBy], references: [id])
  owner       User?        @relation("TaskListOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tasks       Task[]
  attachments Attachment[]

  @@index([projectId, position])
  @@index([ownerUserId])
  @@map("task_lists")
}

/// Custom statuses per project — 4 defaults auto-created on project creation
model Status {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  name        String
  color       String      @default("#94a3b8")
  position    Int         @default(1000)
  group       StatusGroup @default(ACTIVE)
  isDefault   Boolean     @default(false) @map("is_default")
  isProtected Boolean     @default(false) @map("is_protected")
  isClosed    Boolean     @default(false) @map("is_closed")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, group, position])
  @@map("statuses")
}

/// Workspace-scoped tags applied to tasks
model Tag {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  color       String    @default("#6366f1")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskTags  TaskTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

/// Core task entity — self-referencing for subtasks (max depth 2)
model Task {
  id                   String    @id @default(uuid())
  listId               String    @map("list_id")
  parentId             String?   @map("parent_id")
  depth                Int       @default(0)
  title                String
  description          String?
  descriptionJson      Json?     @map("description_json")
  descriptionPlaintext String?   @map("description_plaintext")
  statusId             String    @map("status_id")
  priority             Priority  @default(NONE)
  taskNumber           Int       @map("task_number")
  startDate            DateTime? @map("start_date")
  dueDate              DateTime? @map("due_date")
  position             Int       @default(1000)
  boardPosition        Int       @default(1000) @map("board_position")
  isCompleted          Boolean   @default(false) @map("is_completed")
  completedAt          DateTime? @map("completed_at")
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Relations
  list        TaskList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  parent      Task?          @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]         @relation("TaskSubtasks")
  status      Status         @relation(fields: [statusId], references: [id])
  creator     User           @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees   TaskAssignee[]
  tags        TaskTag[]
  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  favorites   TaskFavorite[]

  @@index([listId, position])
  @@index([listId, parentId, position])
  @@index([statusId])
  @@index([statusId, boardPosition])
  @@index([dueDate])
  @@map("tasks")
}

/// User-specific favorite projects for quick access/starred views
model ProjectFavorite {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([workspaceId, userId, createdAt])
  @@index([projectId])
  @@map("project_favorites")
}

/// User-specific favorite tasks for quick access/starred views
model TaskFavorite {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([workspaceId, userId, createdAt])
  @@index([taskId])
  @@map("task_favorites")
}

/// Junction: Task <-> User for multi-assignee support
model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedBy String   @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User @relation("AssignedUser", fields: [userId], references: [id])
  assigner User @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// Junction: Task <-> Tag
model TaskTag {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@map("task_tags")
}

/// Task comments with threading — parent deletion cascades to replies
model Comment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  parentId  String?   @map("parent_id")
  content   String
  isEdited  Boolean   @default(false) @map("is_edited")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [userId], references: [id])
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  mentions  Mention[]
  reactions Reaction[]

  @@index([taskId, createdAt])
  @@map("comments")
}

/// Reactions on comments (one reaction belongs to one comment)
model Reaction {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  memberId  String   @map("member_id")
  reactFace String   @default("") @map("react_face")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  comment Comment         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId, reactFace])
  @@index([commentId])
  @@index([memberId])
  @@map("reactions")
}

/// @mentions in comments — used for notification targeting
model Mention {
  id              String   @id @default(uuid())
  commentId       String   @map("comment_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id])

  @@unique([commentId, mentionedUserId])
  @@map("mentions")
}

/// In-app notifications — polymorphic reference, auto-cleaned after 90 days
model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  workspaceId   String    @map("workspace_id")
  type          String
  title         String
  message       String?
  referenceType String    @map("reference_type")
  referenceId   String    @map("reference_id")
  actorId       String?   @map("actor_id")
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at")
  isCleared     Boolean   @default(false) @map("is_cleared")
  isSnoozed     Boolean   @default(false) @map("is_snoozed")
  snoozedAt     DateTime? @map("snoozed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  recipient   User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id])
  isCommented Boolean   @default(false) @map("is_commented")

  @@index([userId, isRead, isCleared, isSnoozed, createdAt])
  @@index([workspaceId, userId])
  @@map("notifications")
}

/// File attachments on tasks, docs, channel messages, projects, task lists,
/// and AI conversations — stored in AWS S3
model Attachment {
  id                      String                 @id @default(uuid())
  taskId                  String?                @map("task_id")
  docId                   String?                @map("doc_id")
  channelMessageId        String?                @map("channel_message_id")
  projectId               String?                @map("project_id")
  taskListId              String?                @map("task_list_id")
  aiConversationId        String?                @map("ai_conversation_id")
  aiConversationMessageId String?                @map("ai_conversation_message_id")
  uploadedBy              String                 @map("uploaded_by")
  fileName                String                 @map("file_name")
  s3Key                   String?                @unique @map("s3_key")
  mimeType                String?                @map("mime_type")
  fileSize                BigInt?                @map("file_size")
  kind                    AttachmentKind         @default(FILE)
  contentType             AttachmentContentType? @map("content_type")
  uploadStatus            AttachmentUploadStatus @default(CONFIRMED) @map("upload_status")
  metadata                Json?
  linkUrl                 String?                @map("link_url")
  title                   String?
  description             String?
  createdAt               DateTime               @default(now()) @map("created_at")
  /// @default(now()) mirrors the DB default added in migration
  /// 20260710124006 so existing rows could be backfilled. Without it declared
  /// here, every `prisma migrate diff` reports drift and tries to DROP DEFAULT,
  /// which would re-break that migration for anyone replaying the chain.
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt               DateTime?              @map("deleted_at")

  // Relations
  task                  Task?                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doc                   Doc?                   @relation(fields: [docId], references: [id], onDelete: Cascade)
  channelMessage        ChannelMessage?        @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskList              TaskList?              @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  aiConversation        AiConversation?        @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)
  aiConversationMessage AiConversationMessage? @relation(fields: [aiConversationMessageId], references: [id], onDelete: Cascade)
  uploader              User                   @relation(fields: [uploadedBy], references: [id])

  @@index([taskId])
  @@index([docId])
  @@index([channelMessageId])
  @@index([projectId])
  @@index([taskListId])
  @@index([aiConversationId, deletedAt, createdAt])
  @@index([aiConversationMessageId])
  @@map("attachments")
}

/// Time tracking — manual logging + timer-based
model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int?
  isManual    Boolean   @default(false) @map("is_manual")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, userId])
  @@map("time_entries")
}

/// Central audit trail — append-only, no updates, no deletes
model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  fieldName   String?  @map("field_name")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  metadata    Json     @default("{}")
  performedBy String   @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  performer User      @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
  @@index([performedBy, createdAt])
  @@map("activity_logs")
}

// Channels (chat/discussion spaces inside workspace, optionally scoped to a project)
enum ChannelPrivacy {
  PUBLIC
  PRIVATE
}

enum ChannelKind {
  CHANNEL
  DM
}

enum ChannelMessageKind {
  USER
  SYSTEM
}

enum ChannelJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Channel {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  projectId   String?        @map("project_id")
  name        String?
  description String?
  kind        ChannelKind    @default(CHANNEL)
  privacy     ChannelPrivacy @default(PUBLIC)
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id])
  members      ChannelMember[]
  messages     ChannelMessage[]
  joinRequests ChannelJoinRequest[]

  @@index([workspaceId])
  @@index([workspaceId, kind])
  @@index([projectId])
  @@map("channels")
}

model ChannelMember {
  id                String   @id @default(uuid())
  channelId         String   @map("channel_id")
  userId            String   @map("user_id")
  role              Role     @default(MEMBER)
  isMuted           Boolean  @default(false) @map("is_muted")
  lastReadMessageId String?  @map("last_read_message_id")
  unreadCount       Int      @default(0) @map("unread_count")
  joinedAt          DateTime @default(now()) @map("joined_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@index([userId])
  @@index([userId, channelId])
  @@map("channel_members")
}

model ChannelMessage {
  id               String             @id @default(uuid())
  channelId        String             @map("channel_id")
  senderId         String?            @map("sender_id")
  kind             ChannelMessageKind @default(USER)
  contentJson      Json               @map("content_json")
  plaintext        String             @default("")
  replyToMessageId String?            @map("reply_to_message_id")
  isEdited         Boolean            @default(false) @map("is_edited")
  editedAt         DateTime?          @map("edited_at")
  isPinned         Boolean            @default(false) @map("is_pinned")
  pinnedAt         DateTime?          @map("pinned_at")
  pinnedById       String?            @map("pinned_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  channel     Channel                  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User?                    @relation("ChannelMessageSender", fields: [senderId], references: [id])
  pinnedBy    User?                    @relation("ChannelMessagePinner", fields: [pinnedById], references: [id])
  replyTo     ChannelMessage?          @relation("ChannelMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies     ChannelMessage[]         @relation("ChannelMessageReply")
  mentions    ChannelMessageMention[]
  reactions   ChannelMessageReaction[]
  attachments Attachment[]

  @@index([channelId, createdAt(sort: Desc), id])
  @@index([channelId, isPinned, createdAt])
  @@index([senderId])
  @@map("channel_messages")
}

model ChannelMessageMention {
  id              String   @id @default(uuid())
  messageId       String   @map("message_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  message       ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User           @relation(fields: [mentionedUserId], references: [id])

  @@unique([messageId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("channel_message_mentions")
}

model ChannelMessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("channel_message_reactions")
}

model ChannelJoinRequest {
  id          String                   @id @default(uuid())
  channelId   String                   @map("channel_id")
  userId      String                   @map("user_id")
  status      ChannelJoinRequestStatus @default(PENDING)
  requestedAt DateTime                 @default(now()) @map("requested_at")
  decidedById String?                  @map("decided_by_id")
  decidedAt   DateTime?                @map("decided_at")

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation("JoinRequester", fields: [userId], references: [id])
  decidedBy User?   @relation("JoinRequestDecider", fields: [decidedById], references: [id])

  @@unique([channelId, userId, status])
  @@index([channelId, status])
  @@map("channel_join_requests")
}

// ============================================================
// AI CONVERSATIONS (SwiftBot)
// ============================================================
enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiMessageStatus {
  COMPLETE
  ABORTED
}

/// How a turn's token figures were obtained. Recorded so quota accounting is
/// auditable and so estimated consumption can be treated differently from
/// measured consumption when enforcing limits.
enum TokenSource {
  /// OpenAI's usage chunk arrived — authoritative.
  MEASURED
  /// Stream ended early (abort): prompt counted with the tokenizer, reply
  /// counted from the text actually received.
  TOKENIZED_PROMPT
  /// Tokenizer unavailable; character-ratio fallback. Least accurate.
  HEURISTIC
  /// No figures available at all.
  UNKNOWN
}

model AiConversation {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  title       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiConversationMessage[]
  attachments Attachment[]

  @@index([workspaceId, userId, deletedAt, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String          @id @default(uuid())
  conversationId String          @map("conversation_id")
  role           AiMessageRole
  content        String
  status         AiMessageStatus @default(COMPLETE)
  /// Model that produced this turn. Null for user turns and for
  /// assistant rows written before per-message attribution existed.
  model            String?  @map("model")
  /// Measured token counts, straight from OpenAI's usage chunk. Null when the
  /// stream ended before that chunk arrived — see estimated* below.
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  /// Subset of promptTokens OpenAI billed at the discounted cache-read rate
  /// (prompt_tokens_details.cached_tokens). Null when not measured, same
  /// convention as the other measured columns — 0 means "measured, no cache
  /// hit", distinct from null meaning "we don't know".
  cachedPromptTokens    Int? @map("cached_prompt_tokens")
  /// Subset of promptTokens OpenAI billed at the (higher) cache-write rate
  /// (prompt_tokens_details.cache_write_tokens). Only ever populated for
  /// models whose usage response includes this field (the 5.6 family) —
  /// gpt-4o-mini's response never has it, so this stays null there.
  cacheWritePromptTokens Int? @map("cache_write_prompt_tokens")
  /// Counted locally when the measured figures are unavailable (abort path).
  /// Kept separate so the measured columns stay authoritative and the accuracy
  /// of quota accounting stays queryable.
  estimatedPromptTokens     Int? @map("estimated_prompt_tokens")
  estimatedCompletionTokens Int? @map("estimated_completion_tokens")
  tokenSource               TokenSource? @map("token_source")
  /// Images are billed by dimensions, which a text tokenizer cannot see. Recorded
  /// so the residual on aborted vision requests is measurable.
  imageCount                Int? @map("image_count")
  /// Null means "not measured" (unknown rate), distinct from 0.00 meaning "free".
  estimatedCostUsd Decimal? @map("estimated_cost_usd") @db.Decimal(12, 6)
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

// ============================================================
// DOCS FEATURE
// ============================================================

enum DocScope {
  WORKSPACE
  PROJECT
  PERSONAL
}

enum DocRole {
  VIEWER
  COMMENTER
  EDITOR
  OWNER
}

enum DocVersionType {
  AUTO
  MANUAL
  RESTORE_SAFETY
}

/// A document — belongs to a workspace, optionally a project, always has an owner
model Doc {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  projectId        String?   @map("project_id")
  ownerId          String    @map("owner_id")
  scope            DocScope
  title            String
  contentJson      Json      @default("{}") @map("content_json")
  plaintext        String    @default("") // denormalized text extracted from contentJson for full-text search
  version          Int       @default(0)
  lastCheckpointAt DateTime? @map("last_checkpoint_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner       User               @relation("DocOwner", fields: [ownerId], references: [id])
  versions    DocVersion[]
  permissions DocPermission[]
  threads     DocCommentThread[]
  shareLinks  DocShareLink[]
  attachments Attachment[]

  @@index([workspaceId, scope, deletedAt])
  @@index([projectId])
  @@index([ownerId])
  @@map("docs")
}

/// Point-in-time snapshot of a Doc — auto every 20 min or manual by user
model DocVersion {
  id          String         @id @default(uuid())
  docId       String         @map("doc_id")
  contentJson Json           @map("content_json")
  type        DocVersionType
  label       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  createdById String         @map("created_by_id")

  // Relations
  doc       Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  createdBy User @relation("DocVersionCreator", fields: [createdById], references: [id])

  @@index([docId, createdAt])
  @@map("doc_versions")
}

/// Per-doc role override — supplements inherited workspace/project role
model DocPermission {
  id          String   @id @default(uuid())
  docId       String   @map("doc_id")
  userId      String   @map("user_id")
  role        DocRole
  grantedById String   @map("granted_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  doc       Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  user      User @relation("DocPermissionGrantee", fields: [userId], references: [id])
  grantedBy User @relation("DocPermissionGranter", fields: [grantedById], references: [id])

  @@unique([docId, userId])
  @@index([userId])
  @@map("doc_permissions")
}

/// A comment thread anchored to a block selection or the doc as a whole
model DocCommentThread {
  id            String   @id @default(uuid())
  docId         String   @map("doc_id")
  anchorBlockId String?  @map("anchor_block_id")
  anchorMeta    Json?    @map("anchor_meta") // { charStart, charEnd } — null when doc-level or orphaned
  resolved      Boolean  @default(false)
  isOrphan      Boolean  @default(false) @map("is_orphan")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  doc       Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  createdBy User         @relation("DocThreadCreator", fields: [createdById], references: [id])
  comments  DocComment[]

  @@index([docId, resolved])
  @@map("doc_comment_threads")
}

/// Single reply within a DocCommentThread
model DocComment {
  id        String    @id @default(uuid())
  threadId  String    @map("thread_id")
  authorId  String    @map("author_id")
  body      String
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  thread DocCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation("DocCommentAuthor", fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@map("doc_comments")
}

/// Public share link — time-limited, role-scoped, revocable
model DocShareLink {
  id          String    @id @default(uuid())
  docId       String    @map("doc_id")
  token       String    @unique
  role        DocRole // VIEWER or COMMENTER only
  expiresAt   DateTime? @map("expires_at")
  createdById String    @map("created_by_id")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  doc       Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  createdBy User @relation("DocShareLinkCreator", fields: [createdById], references: [id])

  @@index([docId])
  @@map("doc_share_links")
}

// ============================================================
// AI MODEL TIER MANAGEMENT
// ============================================================

/// Shared secret gating AI tier changes. Hashed with bcrypt — never
/// reversibly encrypted, since verification only needs a one-way compare.
/// Rows are seeded out-of-band via scripts/set-tier-change-secret.ts.
model TierChangeSecret {
  id         String    @id @default(uuid())
  /// Human-readable owner of this secret, e.g. "office-admin". Appears in audit rows.
  label      String    @unique
  secretHash String    @map("secret_hash")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([revokedAt])
  @@map("tier_change_secrets")
}

/// Sliding-window failed-attempt tracking for the tier-change secret,
/// keyed by the acting user. Mirrors ProjectUnlockAttempt.
model TierChangeAttempt {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")
  lastFailAt  DateTime? @map("last_fail_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@map("tier_change_attempts")
}

/// Weekly token budget for a workspace member. One row per member per period —
/// history is retained rather than overwritten, so past weeks stay queryable.
///
/// Scoped to (workspaceId, userId) to match how aiModelTier is scoped: a user in
/// two workspaces must not share one budget across different tiers.
model AiTokenAllowance {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  /// Start of this budget period (UTC Monday 00:00). Stored rather than computed
  /// at read time — computed windows drift with timezone/DST and make historical
  /// rows unqueryable.
  periodStart DateTime @map("period_start")
  tokenLimit  Int      @map("token_limit")
  /// The single authoritative figure the quota check reads. Incremented inside
  /// the same transaction that writes the message row, so the two cannot diverge.
  consumedTokens Int @default(0) @map("consumed_tokens")
  /// Subset of consumedTokens that came from local counting rather than OpenAI's
  /// usage chunk. Used to avoid ever hard-blocking a user on estimates alone.
  estimatedTokens Int @default(0) @map("estimated_tokens")
  costUsdUsed     Decimal @default(0) @map("cost_usd_used") @db.Decimal(12, 6)
  /// Set when the member accepts falling back to the standard model after
  /// exhausting the budget. Cleared on reset.
  fallbackOptIn Boolean  @default(false) @map("fallback_opt_in")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, periodStart])
  @@index([workspaceId, userId, periodStart(sort: Desc)])
  @@map("ai_token_allowances")
}

enum AiTokenAllowanceEvent {
  LIMIT_SET
  MANUAL_RESET
  PERIOD_ROLLOVER
}

/// Append-only log of allowance changes: limit edits, manual resets, and the
/// closing snapshot of each period.
model AiTokenAllowanceHistory {
  id          String                @id @default(uuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  event       AiTokenAllowanceEvent
  periodStart DateTime              @map("period_start")
  tokenLimit  Int                   @map("token_limit")
  /// Consumption at the moment of the event — the closing figure for a rollover.
  consumedTokens Int     @map("consumed_tokens")
  costUsdUsed    Decimal @map("cost_usd_used") @db.Decimal(12, 6)
  /// Null for automatic rollovers; set for admin-initiated changes.
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("AiTokenAllowanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AiTokenAllowanceActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@map("ai_token_allowance_history")
}

/// Append-only audit of every AI tier change. Records who acted, on whom,
/// in which workspace, and which secret authorised it.
model AiTierChangeLog {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  targetUserId String     @map("target_user_id")
  actorUserId String      @map("actor_user_id")
  fromTier    AiModelTier @map("from_tier")
  toTier      AiModelTier @map("to_tier")
  secretLabel String      @map("secret_label")
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetUser User      @relation("AiTierChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser  User      @relation("AiTierChangeActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([targetUserId])
  @@map("ai_tier_change_logs")
}
